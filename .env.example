# Copia este archivo a .env.local (desarrollo) y pon los mismos valores en Vercel → Settings → Environment Variables.

# --- Cliente (se incluyen en la app; no son secretos: la seguridad la pone RLS) ---
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# Clave pública VAPID para las notificaciones push (npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=

# --- Servidor (solo en Vercel o .env.local; NUNCA con prefijo VITE_) ---
# Supabase → Project Settings → API keys → Secret key. Activa la caché compartida, los avisos y el iCal.
SUPABASE_SECRET_KEY=
# Clave privada VAPID (la pareja de VITE_VAPID_PUBLIC_KEY)
VAPID_PRIVATE_KEY=
# Contacto que se envía con las notificaciones push (mailto:…)
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
# Secreto que pg_cron envía al llamar a /api/recordatorios (cualquier cadena larga aleatoria)
CRON_SECRET=
# Opcionales
OFF_CONTACTO=
MERCADONA_ALMACEN=vlc1
